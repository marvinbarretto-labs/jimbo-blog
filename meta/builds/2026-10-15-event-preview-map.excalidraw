    {"type":"text","id":"title","x":40,"y":20,"width":680,"height":40,"text":"LocalShout: where the event disappears","originalText":"LocalShout: where the event disappears","fontSize":28,"fontFamily":1,"autoResize":true,"strokeColor":"#1e1e1e"},
    {"type":"text","id":"scope","x":40,"y":75,"width":730,"height":50,"text":"Evidence: JIM-7273, checked 12 Oct. Not a fresh production diagnosis.\nBlue = reported path; orange = suspects; green = proposed proof.","originalText":"Evidence: JIM-7273, checked 12 Oct. Not a fresh production diagnosis.\nBlue = reported path; orange = suspects; green = proposed proof.","fontSize":16,"fontFamily":1,"autoResize":true,"strokeColor":"#454545"},
