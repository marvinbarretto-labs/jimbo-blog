    {"type":"text","id":"tpage","x":50,"y":170,"width":310,"height":60,"text":"EVENT PAGE\nSame named lookup renders event\nReported working on 12 Oct","originalText":"EVENT PAGE\nSame named lookup renders event\nReported working on 12 Oct","fontSize":18,"fontFamily":1,"containerId":"page","textAlign":"center","verticalAlign":"middle","autoResize":true},
